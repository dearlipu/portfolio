---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="page-shell content-section" data-reveal>
      <div class="section-heading">
        <span class="eyebrow">03 / experience</span>
      </div>
      <div class="experience-list">
        {siteConfig.experience.map((exp) => (
          <article class="experience-row" data-reveal>
            <div>
              <h3>{exp.title}</h3>
              <p class="company">{exp.company}</p>
            </div>
            <div>
              <div class="meta">
                <p class="date">{exp.dateRange}</p>
                {exp.jobType && <p class="job-type">{exp.jobType}</p>}
              </div>
              <ul>
                {exp.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>
  )
}

<style>
  .section-heading {
    border-top: none;
    padding-top: 0;
  }

  .experience-list {
    margin-top: 0;
  }
  .experience-row {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 24px;
    border-bottom: 1px solid var(--line);
    padding: 34px 0 42px;
  }
  h3 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.7rem, 3vw, 2.8rem);
    font-weight: 400;
    letter-spacing: -0.05em;
  }
  .company,
  .date,
  .job-type {
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.6;
  }
  .meta {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }
  .date,
  .job-type {
    margin: 0;
  }
  .job-type {
    text-align: right;
  }
  ul {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
  }
  li {
    margin-bottom: 10px;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.6;
  }
  li::before {
    content: "+ ";
    color: var(--accent);
  }
  @media (max-width: 820px) {
    .experience-row {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
</style>
