---
import { siteConfig } from "../config";
---

<section id="hero" class="hero page-shell">
  <div class="hero-copy">
    <p class="eyebrow">Balugaon, Odisha, India</p>
    <h1>{siteConfig.name}</h1>
    <p class="hero-role">{siteConfig.title}</p>
  </div>
  <div class="hero-footer">
    <div class="hero-footer-top">
      <span class="scroll-note">scroll to explore <span>↓</span></span>
      <a
        class="resume-link"
        href="https://dearlipu.is-a.dev/resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
      >
        resume <span>↗</span>
      </a>
    </div>
    <div class="hero-footer-line" aria-hidden="true"></div>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100vh - 78px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 12vh 0 36px;
  }
  .hero-copy {
    max-width: 900px;
    display: flex;
    flex-direction: column;
    animation: rise 0.8s ease-out both;
  }
  .hero h1 {
    margin: 28px 0 12px;
    font-family: var(--serif);
    font-size: clamp(4rem, 12vw, 10.5rem);
    font-weight: 400;
    letter-spacing: -0.08em;
    line-height: 0.82;
  }
  .hero-role {
    margin: 0;
    font-size: clamp(1rem, 2vw, 1.4rem);
    color: var(--muted);
  }
  .hero-intro {
    max-width: 610px;
    margin-top: 42px;
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    line-height: 1.7;
  }
  .hero-footer {
    position: sticky;
    bottom: 20px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    margin-top: clamp(3rem, 12vh, 8rem);
    background: var(--paper);
  }
  .hero-footer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }
  .hero-footer-line {
    width: 100%;
    height: 1px;
    background: var(--line);
    margin-top: 20px;
  }
  .scroll-note {
    color: var(--muted);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .scroll-note span {
    color: var(--ink);
    font-size: 1rem;
    margin-left: 8px;
  }
  .resume-link {
    color: var(--muted);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 180ms ease;
  }
  .resume-link:hover,
  .resume-link:focus-visible {
    color: var(--ink);
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: calc(100vh - 65px);
      padding-top: 10vh;
      padding-bottom: 28px;
    }
    .hero h1 {
      margin-top: 24px;
      font-size: clamp(4rem, 20vw, 7rem);
    }
    .hero-role {
      margin-top: 0;
    }
    .hero-intro {
      margin-top: 30px;
    }
    .hero-footer {
      margin-top: 2.5rem;
    }
    .hero-footer-top {
      padding-top: 18px;
    }
    .hero-footer-line {
      margin-top: 18px;
    }
  }
</style>
