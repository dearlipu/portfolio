---
import { siteConfig } from "../config";
---

<section id="hero" class="hero page-shell">
  <div class="hero-copy">
    <p class="eyebrow location-line">
      <span class="location-icon" aria-hidden="true">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path>
          <path
            d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0"
          ></path>
        </svg>
      </span>
      Odisha, India
    </p>
    <h1 data-name-scramble={siteConfig.name}>{siteConfig.name}</h1>
    <p class="hero-role">
      <span class="typewriter" data-typewriter={siteConfig.heroRoles.join("|")}>
        {siteConfig.title}
      </span>
    </p>
  </div>

  <div class="hero-footer">
    <div class="hero-footer-top">
      <span class="scroll-note">
        scroll to explore
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="scroll-icon"
          aria-hidden="true"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M12 5l0 14"></path>
          <path d="M18 13l-6 6"></path>
          <path d="M6 13l6 6"></path>
        </svg>
      </span>
      <a
        class="resume-link"
        href="https://dearlipu.is-a.dev/resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
      >
        resume
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="resume-icon"
          aria-hidden="true"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M12 9h.01"></path>
          <path
            d="M3 5a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-14"
          ></path>
          <path d="M11 12h1v4h1"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  const name = document.querySelector<HTMLElement>("[data-name-scramble]");
  const typewriter = document.querySelector<HTMLElement>("[data-typewriter]");
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!reduceMotion) {
    typewriter?.classList.add("is-waiting");
  }

  const startTypewriter = () => {
    if (!typewriter) return;

    const phrases = (typewriter.dataset.typewriter ?? "").split("|");
    let phraseIndex = 0;
    let characterIndex = 0;
    typewriter.textContent = "";
    typewriter.classList.remove("is-waiting");
    typewriter.classList.add("is-typing");

    const typeNextCharacter = () => {
      const text = phrases[phraseIndex] ?? "";
      typewriter.textContent = text.slice(0, characterIndex);
      characterIndex += 1;

      if (characterIndex <= text.length) {
        window.setTimeout(typeNextCharacter, 72);
      } else {
        window.setTimeout(eraseCharacter, 2200);
      }
    };

    const eraseCharacter = () => {
      const text = phrases[phraseIndex] ?? "";
      characterIndex -= 1;
      typewriter.textContent = text.slice(0, characterIndex);

      if (characterIndex > 0) {
        window.setTimeout(eraseCharacter, 38);
      } else {
        phraseIndex = (phraseIndex + 1) % phrases.length;
        window.setTimeout(typeNextCharacter, 550);
      }
    };

    typeNextCharacter();
  };

  if (reduceMotion) {
    // Keep the server-rendered text visible without animation.
  } else if (name) {
    const text = name.dataset.nameScramble ?? "";
    const characters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&*";
    let revealedCharacters = 0;
    name.classList.add("is-scrambling");

    const scrambleName = () => {
      const middleIndex = Math.floor(text.length / 2);
      const fragment = document.createDocumentFragment();

      [...text].forEach((character, index) => {
        const letter = document.createElement("span");
        const isRevealed = character === " " || index < revealedCharacters;
        letter.textContent = isRevealed
          ? character
          : characters[Math.floor(Math.random() * characters.length)];

        if (
          !isRevealed &&
          (Math.abs(index - middleIndex) <= 1 || index % 3 === 0)
        ) {
          letter.className = "scramble-accent";
        }

        fragment.append(letter);
      });

      name.replaceChildren(fragment);

      revealedCharacters += 0.2;

      if (revealedCharacters < text.length) {
        window.setTimeout(scrambleName, 80);
      } else {
        name.textContent = text;
        name.classList.remove("is-scrambling");
        window.setTimeout(startTypewriter, 220);
      }
    };

    window.setTimeout(scrambleName, 180);
  } else {
    startTypewriter();
  }
</script>

<style>
  .hero {
    min-height: calc(100vh - 78px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 12vh 0 36px;
  }

  .hero-copy {
    max-width: 900px;
    display: flex;
    flex-direction: column;
    animation: rise 0.8s ease-out both;
  }

  .location-line {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (min-width: 641px) {
    .location-line {
      align-self: flex-end;
    }
  }

  .location-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    color: var(--accent);
    line-height: 1;
  }

  .location-icon svg {
    display: block;
    width: 14px;
    height: 14px;
  }

  .hero h1 {
    margin: 28px 0 12px;
    font-family: var(--serif);
    font-size: clamp(4rem, 12vw, 10.5rem);
    font-weight: 400;
    letter-spacing: -0.08em;
    line-height: 0.82;
    white-space: pre-wrap;
  }

  @media (min-width: 641px) {
    .hero h1.is-scrambling {
      white-space: nowrap;
    }
  }

  :global(.scramble-accent) {
    color: var(--accent);
  }

  .hero-role {
    margin: 0;
    font-size: clamp(1rem, 2vw, 1.4rem);
    color: var(--muted);
  }

  .typewriter.is-typing::after {
    display: inline-block;
    width: 0;
    height: 1.1em;
    margin-left: 0.12em;
    border-right: 1px solid currentColor;
    content: "";
    vertical-align: -0.16em;
    animation: cursor-blink 900ms steps(1, end) infinite;
  }

  .typewriter.is-waiting {
    opacity: 0;
  }

  .hero-footer {
    display: flex;
    flex-direction: column;
    margin-top: clamp(3rem, 12vh, 8rem);
    border-bottom: 1px solid var(--line);
    padding-bottom: 20px;
  }

  .hero-footer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }

  .scroll-note {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1;
    white-space: nowrap;
  }

  .scroll-icon {
    width: 14px;
    height: 14px;
    display: block;
    color: var(--ink);
    flex-shrink: 0;
  }

  .resume-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 24px;
    padding: 0;
    color: var(--muted);
    font-size: 0.7rem;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: color 180ms ease;
  }

  .resume-icon {
    width: 14px;
    height: 14px;
    display: block;
    flex-shrink: 0;
  }

  .resume-link:hover,
  .resume-link:focus-visible {
    color: var(--ink);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes cursor-blink {
    50% {
      border-color: transparent;
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: calc(100vh - 65px);
      min-height: calc(100svh - 70px);
      padding-top: min(10svh, 80px);
      padding-bottom: 28px;
    }

    .hero h1 {
      margin-top: 24px;
      font-size: clamp(4rem, 20vw, 7rem);
    }

    .hero-role {
      margin-top: 0;
    }

    .hero-footer {
      margin-top: 2.5rem;
      padding-bottom: 18px;
    }

    .hero-footer-top {
      padding-top: 18px;
    }
  }
</style>
