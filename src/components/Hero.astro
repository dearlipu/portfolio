---
import { siteConfig } from "../config";
---

<section id="hero" class="hero page-shell">
  <div class="hero-copy">
    <p class="eyebrow">Balugaon, Odisha, India</p>
    <h1>{siteConfig.name}</h1>
    <p class="hero-role">{siteConfig.title}</p>
  </div>
  <div class="hero-footer">
    <span class="scroll-note">scroll to explore <span>↓</span></span>
    <div class="social-links">
      {
        siteConfig.social?.email && (
          <a
            href={`mailto:${siteConfig.social.email}`}
            aria-label="Email"
            class="transition-colors duration-300 hover:text-[var(--accent)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
              <path d="M3 7l9 6l9 -6" />
            </svg>
          </a>
        )
      }
      {
        siteConfig.social?.linkedin && (
          <a
            href={siteConfig.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="transition-colors duration-300 hover:text-[var(--accent)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
            >
              <>
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M8 11v5" />
                <path d="M8 8v.01" />
                <path d="M12 16v-5" />
                <path d="M16 16v-3a2 2 0 1 0 -4 0" />
                <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
              </>
            </svg>
          </a>
        )
      }
      {
        siteConfig.social?.twitter && (
          <a
            href={siteConfig.social.twitter}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Twitter"
            class="transition-colors duration-300 hover:text-[var(--accent)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
            >
              <>
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M4 4l11.733 16h4.267l-11.733 -16z" />
                <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" />
              </>
            </svg>
          </a>
        )
      }
      {
        siteConfig.social?.github && (
          <a
            href={siteConfig.social.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="transition-colors duration-300 hover:text-[var(--accent)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
            >
              <>
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
              </>
            </svg>
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100vh - 78px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 12vh 0 36px;
  }
  .hero-copy {
    max-width: 900px;
    display: flex;
    flex-direction: column;
    animation: rise 0.8s ease-out both;
  }
  .hero h1 {
    margin: 28px 0 12px;
    font-family: var(--serif);
    font-size: clamp(4rem, 12vw, 10.5rem);
    font-weight: 400;
    letter-spacing: -0.08em;
    line-height: 0.82;
  }
  .hero-role {
    margin: 0;
    font-size: clamp(1rem, 2vw, 1.4rem);
    color: var(--muted);
  }
  .hero-intro {
    max-width: 610px;
    margin-top: 42px;
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    line-height: 1.7;
  }
  .hero-footer {
    position: sticky;
    bottom: 20px;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: clamp(3rem, 12vh, 8rem);
    border-top: 1px solid var(--line);
    background: var(--paper);
    padding-top: 20px;
  }
  .scroll-note {
    color: var(--muted);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .scroll-note span {
    color: var(--ink);
    font-size: 1rem;
    margin-left: 8px;
  }
  .social-links {
    display: flex;
    gap: 18px;
  }
  .social-links a {
    color: var(--muted);
  }
  .social-links a:hover {
    color: var(--ink);
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: calc(100vh - 65px);
      padding-top: 10vh;
      padding-bottom: 28px;
    }
    .hero h1 {
      margin-top: 24px;
      font-size: clamp(4rem, 20vw, 7rem);
    }
    .hero-role {
      margin-top: 0;
    }
    .hero-intro {
      margin-top: 30px;
    }
    .hero-footer {
      margin-top: 2.5rem;
      padding-top: 18px;
    }
  }
</style>
