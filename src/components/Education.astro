---
import { siteConfig } from "../config";
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{
  hasEducation && (
    <section id="education" class="page-shell content-section" data-reveal>
      <div class="section-heading">
        <span class="eyebrow">04 / education</span>
      </div>
      <div class="education-list">
        {siteConfig.education.map((edu) => (
          <article class="education-row" data-reveal>
            <div>
              <h3>{edu.degree}</h3>
              <p>{edu.school}</p>
            </div>
            <span>{edu.dateRange}</span>
          </article>
        ))}
      </div>
    </section>
  )
}

<style>
  .section-heading {
    border-top: none;
    padding-top: 0;
  }

  .education-list {
    margin-top: 0;
  }
  .education-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 24px;
    border-bottom: 1px solid var(--line);
    padding: 28px 0 40px;
  }
  h3 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.4rem, 2.5vw, 2.2rem);
    font-weight: 400;
    letter-spacing: -0.05em;
  }
  p,
  .education-row > span {
    margin: 0;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.6;
  }
  @media (max-width: 600px) {
    .education-row {
      display: block;
    }
    .education-row > span {
      display: block;
      margin-top: 12px;
    }
  }
</style>
