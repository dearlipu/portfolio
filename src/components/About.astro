---
import { siteConfig } from "../config";
---

<section id="about" class="page-shell content-section" data-reveal>
  <div class="section-heading">
    <span class="eyebrow">01 / about</span>
  </div>
  <div class="about-grid" data-reveal>
    <h2>Useful work,<br /><em>well considered.</em></h2>
    <div>
      <p class="about-copy">{siteConfig.aboutMe}</p>
      <div class="skill-list" aria-label="Skills">
        <div class="skill-entry">
          <span class="skill-label">Languages</span>
          <div class="skill-values">
            {siteConfig.languages.map((item) => <span>{item}</span>)}
          </div>
        </div>
        <div class="skill-entry">
          <span class="skill-label">Skills</span>
          <div class="skill-values">
            {siteConfig.skills.map((item) => <span>{item}</span>)}
          </div>
        </div>
        <div class="skill-entry">
          <span class="skill-label">Software</span>
          <div class="skill-values">
            {siteConfig.software.map((item) => <span>{item}</span>)}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: clamp(24px, 2.8vw, 32px);
    padding-bottom: 0;
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10%;
    padding-top: 0;
  }
  h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.8rem, 6vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.07em;
    line-height: 0.92;
  }
  h2 em {
    color: var(--muted);
    font-style: italic;
  }
  .about-copy {
    margin: 0;
    font-size: clamp(0.9rem, 1.3vw, 1.12rem);
    line-height: 1.6;
  }
  .skill-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 44px;
    border-top: 1px solid var(--line);
    padding-top: 18px;
  }
  .skill-entry {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 18px;
    align-items: start;
  }
  .skill-label {
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .skill-values {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    color: var(--muted);
    font-size: 0.76rem;
    line-height: 1.8;
  }
  .skill-values span::before {
    content: "+ ";
    color: var(--accent);
  }
  @media (max-width: 700px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 36px;
      padding-top: 36px;
    }
  }
</style>
