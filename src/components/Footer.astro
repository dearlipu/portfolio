---
import { siteConfig } from "../config";
---

<footer class="page-shell footer" data-reveal>
  <div class="footer-rule"></div>
  <div class="footer-grid">
    <div>
      <p class="eyebrow">Have a project in mind?</p>
      <h2>Let's make something<br /><em>useful together.</em></h2>
    </div>
    <div class="footer-links">
      <a class="email-link" href={`mailto:${siteConfig.social.email}`}
        >{siteConfig.social.email} <span>↗</span></a
      >
      <div class="socials">
        {
          siteConfig.social.github && (
            <a
              href={siteConfig.social.github}
              target="_blank"
              rel="noopener noreferrer"
            >
              github
            </a>
          )
        }
        {
          siteConfig.social.website && (
            <a
              href={siteConfig.social.website}
              target="_blank"
              rel="noopener noreferrer"
            >
              website
            </a>
          )
        }
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <span>{siteConfig.name}</span><span
      >© {new Date().getFullYear()} · built with care</span
    >
  </div>
</footer>

<style>
  .footer {
    padding: 80px 0 28px;
  }
  .footer-rule {
    border-top: 1px solid var(--line);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10%;
    padding: 60px 0 100px;
  }
  h2 {
    margin: 28px 0 0;
    font-family: var(--serif);
    font-size: clamp(2.8rem, 6vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.07em;
    line-height: 0.92;
  }
  h2 em {
    color: var(--muted);
    font-style: italic;
  }
  .footer-links {
    display: flex;
    flex-direction: column;
    justify-content: end;
    align-items: start;
    gap: 30px;
  }
  .email-link {
    border-bottom: 1px solid var(--ink);
    padding-bottom: 7px;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .email-link span {
    color: var(--accent);
    margin-left: 14px;
  }
  .socials {
    display: flex;
    gap: 20px;
  }
  .socials a {
    color: var(--muted);
    font-size: 0.75rem;
    text-decoration: none;
  }
  .socials a:hover {
    color: var(--ink);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    padding-top: 15px;
    color: var(--muted);
    font-size: 0.68rem;
  }
  @media (max-width: 700px) {
    .footer {
      padding-top: 40px;
    }
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 50px;
      padding: 45px 0 70px;
    }
  }
</style>
