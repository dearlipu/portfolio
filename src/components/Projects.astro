---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{
  hasProjects && (
    <section id="projects" class="page-shell content-section" data-reveal>
      <div class="section-heading">
        <span class="eyebrow">02 / selected work</span>
      </div>
      <div class="project-list">
        {siteConfig.projects.map((project, index) => (
          <article class="project-row" data-reveal>
            <span class="project-number">0{index + 1}</span>
            <div class="project-main">
              <h3>{project.name}</h3>
              <p>{project.description}</p>
            </div>
            <div class="project-meta">
              <div>
                {project.skills?.map((skill) => (
                  <span>{skill}</span>
                ))}
              </div>
              <span class="project-arrow">↗</span>
            </div>
          </article>
        ))}
      </div>
    </section>
  )
}

<style>
  .project-list {
    margin-top: 22px;
  }
  .project-row {
    display: grid;
    grid-template-columns: 70px 1fr 270px;
    gap: 24px;
    align-items: start;
    border-bottom: 1px solid var(--line);
    padding: 30px 0;
    transition:
      transform 180ms ease,
      background-color 180ms ease,
      border-radius 180ms ease;
  }
  .project-row:hover {
    transform: translateX(8px);
    background: var(--hover-surface);
    border-radius: 3px;
  }
  .project-row:hover .project-number,
  .project-row:hover .project-meta,
  .project-row:hover .project-main p,
  .project-row:hover h3,
  .project-row:hover .project-arrow {
    color: #182018;
  }
  .project-number,
  .project-meta {
    color: var(--muted);
    font-size: 0.72rem;
  }
  h3 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.7rem, 3vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.05em;
  }
  .project-main p {
    max-width: 540px;
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.7;
  }
  .project-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .project-meta div {
    display: flex;
    flex-wrap: wrap;
    justify-content: end;
    gap: 5px 12px;
  }
  .project-meta div span::before {
    content: "· ";
  }
  .project-arrow {
    color: var(--ink);
    font-size: 1.3rem;
  }
  @media (max-width: 860px) {
    .project-row {
      grid-template-columns: 35px 1fr;
      gap: 12px;
    }
    .project-meta {
      grid-column: 2;
      justify-content: space-between;
    }
    .project-meta div {
      justify-content: start;
    }
  }
</style>
