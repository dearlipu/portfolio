---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const visibleProjects = siteConfig.projects.slice(0, 5);
const hiddenProjects = siteConfig.projects.slice(5);

const toRomanNumeral = (value: number) => {
  const numerals: Array<[number, string]> = [
    [1000, "M"],
    [900, "CM"],
    [500, "D"],
    [400, "CD"],
    [100, "C"],
    [90, "XC"],
    [50, "L"],
    [40, "XL"],
    [10, "X"],
    [9, "IX"],
    [5, "V"],
    [4, "IV"],
    [1, "I"],
  ];

  let remaining = value;
  let result = "";

  for (const numeralEntry of numerals) {
    const number = numeralEntry[0] as number;
    const numeral = numeralEntry[1];

    while (remaining >= number) {
      result += numeral;
      remaining -= number;
    }
  }

  return result;
};
---

{
  hasProjects && (
    <section id="projects" class="page-shell content-section" data-reveal>
      <div class="section-heading">
        <span class="eyebrow">02 / selected work</span>
      </div>
      <div class="project-list">
        {visibleProjects.map((project, index) => (
          <article class="project-row" data-reveal tabindex="0">
            <span class="project-number">{toRomanNumeral(index + 1)}</span>
            <div class="project-main">
              <h3>{project.name}</h3>
              <p>{project.description}</p>
            </div>
            <div class="project-meta">
              <div>
                {project.skills?.map((skill) => (
                  <span>{skill}</span>
                ))}
              </div>
              <span class="project-arrow" aria-hidden="true">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M17 7l-10 10" />
                  <path d="M8 7l9 0l0 9" />
                </svg>
              </span>
            </div>
          </article>
        ))}

        {hiddenProjects.length > 0 && (
          <div class="project-extra" data-projects-extra>
            <div class="project-extra-inner">
              {hiddenProjects.map((project, extraIndex) => (
                <article
                  class="project-row project-row-extra"
                  data-reveal
                  tabindex="0"
                >
                  <span class="project-number">
                    {toRomanNumeral(visibleProjects.length + extraIndex + 1)}
                  </span>
                  <div class="project-main">
                    <h3>{project.name}</h3>
                    <p>{project.description}</p>
                  </div>
                  <div class="project-meta">
                    <div>
                      {project.skills?.map((skill) => (
                        <span>{skill}</span>
                      ))}
                    </div>
                    <span class="project-arrow" aria-hidden="true">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M17 7l-10 10" />
                        <path d="M8 7l9 0l0 9" />
                      </svg>
                    </span>
                  </div>
                </article>
              ))}
            </div>
          </div>
        )}

        {hiddenProjects.length > 0 && (
          <div class="project-toggle-wrap">
            <button
              class="project-toggle"
              type="button"
              data-project-toggle
              aria-expanded="false"
            >
              More Projects
            </button>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .project-list {
    margin-top: 0;
  }
  .project-extra {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      max-height 420ms cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 280ms ease,
      margin-top 280ms ease;
  }
  .project-extra.is-expanded {
    max-height: 1400px;
    opacity: 1;
    margin-top: 8px;
  }
  .project-extra-inner {
    display: block;
  }
  .project-row {
    display: grid;
    grid-template-columns: 70px 1fr 270px;
    gap: 24px;
    align-items: start;
    border-bottom: 1px solid var(--line);
    padding: 32px 0 44px;
    cursor: pointer;
    transition:
      transform 180ms ease,
      background-color 180ms ease,
      border-radius 180ms ease,
      box-shadow 180ms ease;
  }
  .project-row:hover,
  .project-row:focus-visible,
  .project-row:active {
    transform: translateX(8px);
    background: var(--accent);
    border-radius: 3px;
    box-shadow: inset 0 0 0 1px rgba(24, 32, 24, 0.15);
  }
  .project-row:hover .project-number,
  .project-row:hover .project-meta,
  .project-row:hover .project-main p,
  .project-row:hover h3,
  .project-row:hover .project-arrow,
  .project-row:focus-visible .project-number,
  .project-row:focus-visible .project-meta,
  .project-row:focus-visible .project-main p,
  .project-row:focus-visible h3,
  .project-row:focus-visible .project-arrow,
  .project-row:active .project-number,
  .project-row:active .project-meta,
  .project-row:active .project-main p,
  .project-row:active h3,
  .project-row:active .project-arrow {
    color: #182018;
  }
  .project-number,
  .project-meta {
    color: var(--muted);
    font-size: 0.72rem;
  }
  h3 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.7rem, 3vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.05em;
  }
  .project-main p {
    max-width: 540px;
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.7;
  }
  .project-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .project-meta div {
    display: flex;
    flex-wrap: wrap;
    justify-content: end;
    gap: 5px 12px;
  }
  .project-meta div span::before {
    content: "· ";
  }
  .project-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    line-height: 1;
  }
  .project-arrow svg {
    display: block;
    width: 1.1rem;
    height: 1.1rem;
  }
  .project-toggle-wrap {
    display: flex;
    justify-content: flex-end;
    margin-top: 18px;
  }
  .project-toggle {
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    min-width: 110px;
    min-height: 44px;
    padding: 10px 14px;
    font-family: inherit;
    font-size: 0.76rem;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: 2px;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease;
  }
  .project-toggle:hover,
  .project-toggle:focus-visible {
    transform: translateY(-1px);
    border-color: rgba(183, 201, 124, 0.7);
    background: rgba(183, 201, 124, 0.06);
    color: var(--ink);
  }
  @media (max-width: 860px) {
    .project-row {
      grid-template-columns: 35px 1fr;
      gap: 12px;
    }
    .project-meta {
      grid-column: 2;
      justify-content: space-between;
    }
    .project-meta div {
      justify-content: start;
    }
  }
</style>

<script>
  const toggleButton = document.querySelector("[data-project-toggle]");
  const extraSection = document.querySelector("[data-projects-extra]");

  if (toggleButton && extraSection) {
    toggleButton.addEventListener("click", () => {
      const isExpanded = extraSection.classList.toggle("is-expanded");
      toggleButton.setAttribute("aria-expanded", String(isExpanded));
      toggleButton.textContent = isExpanded ? "Show Less" : "More Projects";
    });
  }
</script>
